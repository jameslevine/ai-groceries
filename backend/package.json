{
  "name": "ai-groceries-backend",
  "version": "1.0.0",
  "description": "AI Groceries Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.500.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.996.0",
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/client-rekognition": "^3.500.0",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-secrets-manager": "^3.500.0",
    "@aws-sdk/client-ses": "^3.500.0",
    "@aws-sdk/client-sns": "^3.500.0",
    "@aws-sdk/client-sqs": "^3.996.0",
    "@aws-sdk/client-textract": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@sparticuz/chromium": "^121.0.0",
    "aws-jwt-verify": "^4.0.0",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "express": "^4.18.2",
    "joi": "^17.12.0",
    "puppeteer-core": "^22.0.0",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.0"
